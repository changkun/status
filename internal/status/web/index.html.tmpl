<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Status | changkun.de</title>
<meta name="description" content="Current status and 90-day history of changkun.de, golang.design and poly.red, component by component.">
<meta name="color-scheme" content="light dark">
<link rel="preload" href="fonts/inter-400-latin.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="{{.Style}}">
</head>
<body>
<main>
  <header>
    <h1>{{.Lead}}{{if .Word}}<span class="{{.Class}}">{{.Word}}</span>{{end}}</h1>
    <p class="lede">changkun.de, golang.design and poly.red, checked from outside every five minutes.</p>
    {{if .LastChecked}}<p class="checked">Last checked <time datetime="{{.LastCheckedISO}}">{{.LastChecked}}</time></p>{{end}}
    {{if .Stale}}<p class="notice">The newest check is more than 30 minutes old, so the states below may be out of date.</p>{{end}}
  </header>

  {{if .Open}}
  <section class="incidents" aria-labelledby="open-h">
    <h2 id="open-h">Open incidents</h2>
    {{range .Open}}{{template "incident" .}}{{end}}
  </section>
  {{end}}

  <div class="divider"></div>

  <div class="row head" aria-hidden="true">
    <span></span><span></span>
    <span class="axis"><span class="days">90 days ago</span><span class="days-short">30 days ago</span><span>Today</span></span>
    <span class="num">Uptime</span><span class="num">Last</span>
  </div>
  {{range .Sites}}
  <section class="site" aria-label="{{.Name}}">
    <div class="site-head">
      <h2><a href="https://{{.Name}}/">{{.Name}}</a></h2>
      <span class="state {{.Class}}">{{.Label}}</span>
    </div>
    <ul class="rows">
      {{$site := .Name}}{{range .Services}}
      <li class="row {{.Class}}">
        <span class="dot" role="img" aria-label="{{.Label}}" title="{{.Label}}"></span>
        <span class="name">{{.Name}}</span>
        <ol class="bars" aria-label="{{$site}} {{.Name}} daily uptime, last 90 days">
          {{range .Bars}}<li class="bar {{.Class}}" title="{{.Tip}}"></li>{{end}}
        </ol>
        <span class="num">{{.Uptime}}</span>
        <span class="num state {{.Class}}">{{if .Latency}}{{.Latency}}{{else}}{{.Label}}{{end}}</span>
      </li>
      {{end}}
    </ul>
  </section>
  {{end}}
  <p class="legend"><span><i class="key up"></i>Running</span> <span><i class="key degraded"></i>Slow or failed checks</span> <span><i class="key down"></i>Down</span> <span><i class="key nodata"></i>No data</span></p>

  <div class="divider"></div>

  <section class="incidents" aria-labelledby="past-h">
    <h2 id="past-h">Past incidents</h2>
    {{range .Past}}{{template "incident" .}}{{else}}<p class="muted">No incidents in the past 90 days.</p>{{end}}
  </section>
</main>
<footer>
  <p>A component changes state after two bad checks in a row, and a check slower than 3 s counts as slow. Times are UTC.</p>
  <p><a href="https://changkun.de/">Changkun Ou</a> · <a href="https://github.com/changkun/status">Source</a></p>
</footer>
</body>
</html>
{{define "incident"}}
<article class="incident">
  <h3>{{.Title}}</h3>
  <p class="meta">{{if .Open}}<span class="open">Open</span> · {{end}}<time datetime="{{.StartedISO}}">{{.Started}}</time>{{if .Resolved}} to <time datetime="{{.ResolvedISO}}">{{.Resolved}}</time>{{end}}{{if .Components}} · {{.Components}}{{end}}</p>
  {{range .Paragraphs}}<p>{{.}}</p>{{end}}
  {{if .Updates}}
  <ul class="updates">
    {{range .Updates}}<li><time datetime="{{.ISO}}">{{.Time}}</time> <strong>{{.Status}}</strong> {{.Text}}</li>{{end}}
  </ul>
  {{end}}
</article>
{{end}}
